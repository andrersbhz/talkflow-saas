# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database / cache
DATABASE_URL=postgresql://talkflow:talkflow@localhost:5432/talkflow?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-please
JWT_EXPIRES_IN=7d

# WhatsApp provider defaults
WHATSAPP_PROVIDER=meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Optional Evolution adapter
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.5-flash

# Object storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=talkflow
